# ===== ResearchPilot-Agent V5 =====
# 本地运行默认 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite:///../storage/researchpilot.db
STORAGE_DIR=../storage

# OpenAI-compatible LLM；默认按 DeepSeek 兼容接口填写。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# 可选：Semantic Scholar API key。没有也能用，遇到限流会自动跳过。
SEMANTIC_SCHOLAR_API_KEY=

MAX_UPLOAD_MB=50
MAX_RESEARCH_PAPERS=12
CITATION_RETRY_LIMIT=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
